# roots — environment variables
#
# roots reads these from the process environment (it never loads a .env file
# itself). Copy to `.env` for your own shell tooling; `.env` is gitignored.

# Human actor name (`human:<name>`). Falls back to `git config user.name`.
ROOTS_USER=

# Agent actor (`agent:<model>`) for agent-facing commands; `--as` wins.
# While set, human-only commands like `roots tier` refuse to run.
ROOTS_AGENT=

# Print stack traces for unexpected errors.
ROOTS_DEBUG=

# Editor for `plant`, `think`, `adopt` (VISUAL wins over EDITOR).
EDITOR=

# Disable ANSI color (FORCE_COLOR=1 forces it).
NO_COLOR=

# Set by `roots think` for the agent.command it runs (do not set by hand):
#   ROOTS_SESSION, ROOTS_NODE
# Test-only (honored only with NODE_ENV=test, never by agent commands):
#   ROOTS_FORCE_TTY=1
